<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration>

<configuration>
    <import class="ch.qos.logback.classic.encoder.PatternLayoutEncoder"/>
    <import class="ch.qos.logback.core.ConsoleAppender"/>
    <import class="ch.qos.logback.core.rolling.RollingFileAppender"/>
    <import class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy"/>

    <variable name="FILE_LOG_PATTERN" value="%d{yyyy-MM-dd'T'HH:mm:ss z} %-5level %X{prefix} %msg%n" />
    <!-- Archive logs to a folder for each day (e.g. for March 2025: logs/2025/03/14) -->
    <variable name="ARCHIVED_LOG_FOLDER" value="logs/%d{yyyy/MM/dd}" />

    <appender name="STDOUT" class="ConsoleAppender">
        <encoder class="PatternLayoutEncoder">
            <!-- the prefix variable is currently only used in the CheckMonitoredTrip class -->
            <pattern>%highlight(%-5level) %d{yyyy-MM-dd'T'HH:mm:ss.SSS} %yellow([%thread]) %blue(%logger{36}\(%file:%line\)) %yellow(%X{prefix}) %msg%n</pattern>
        </encoder>
    </appender>
    <appender name="NOTIFICATION-FILE" class="RollingFileAppender">
        <file>logs/notifications.log</file>
        <rollingPolicy class="TimeBasedRollingPolicy">
            <!-- Archive logs to a folder -->
            <fileNamePattern>${ARCHIVED_LOG_FOLDER}/notifications.log</fileNamePattern>
            <!-- Keep about two months worth of logs -->
            <maxHistory>62</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>
    <appender name="GMAP-FILE" class="RollingFileAppender">
        <file>logs/gmap.log</file>
        <rollingPolicy class="TimeBasedRollingPolicy">
            <!-- Archive logs to a folder -->
            <fileNamePattern>${ARCHIVED_LOG_FOLDER}/gmap.log</fileNamePattern>
            <!-- Keep about two months worth of logs -->
            <maxHistory>62</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>
    <logger name="org.opentripplanner.middleware.utils.NotificationUtils">
        <appender-ref ref="NOTIFICATION-FILE"/>
    </logger>
    <logger name="org.opentripplanner.middleware.triptracker.interactions.busnotifiers.UsRideGwinnettNotifyBusOperator">
        <appender-ref ref="GMAP-FILE"/>
    </logger>
    <logger name="org.opentripplanner.middleware.triptracker.interactions.UsGdotGwinnettTrafficSignalNotifier">
        <appender-ref ref="GMAP-FILE"/>
    </logger>
    <root level="info">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
